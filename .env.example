# Claude API. Leave empty to run in TEST MODE (deterministic template responses, no API calls).
ANTHROPIC_API_KEY=
# Model used for report narratives, recap emails and the Ask panel.
CLAUDE_MODEL=claude-opus-5-5

# Ads data source: "mock" (sample data). "google_ads" / "meta" adapters are stubs until credentials are wired.
ADS_ADAPTER=mock
# Last complete day of data. Sample data ends 2026-10-22; leave empty with a real adapter to use yesterday.
AS_OF_DATE=2026-10-22

# MCP tool scopes. "read" = reporting tools only. Add "draft" to allow creating PAUSED draft ads.
MCP_SCOPES=read,draft

# Storage (SQLite for runs, drafts and the audit log; PDFs on disk)
DB_PATH=./data/copilot.db
REPORTS_DIR=./reports

# Dashboard protection (optional locally, required when deployed)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Bearer token the scheduled job uses to call POST /api/runs
CRON_SECRET=

# Real ad platform credentials (not used by the mock adapter)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
